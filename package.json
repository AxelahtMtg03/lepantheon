{
  "name": "pantheon",
  "productName": "Le Pantheon",
  "version": "0.1.0",
  "description": "Le Pantheon - client Steam alternatif (non affilie a Valve ni a Steam)",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --mock",
    "test": "node --test tests/",
    "icons": "node scripts/make-icon.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0"
  },
  "author": "Le Pantheon",
  "build": {
    "appId": "fr.lepantheon.app",
    "productName": "Le Pantheon",
    "copyright": "Non affilié à Valve ni à Steam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/**"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Le-Pantheon-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Le Pantheon"
    }
  }
}
